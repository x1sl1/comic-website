<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Comic Website</title>
    @Styles.Render("~/Content/css")
    @RenderSection("head", required: false)
</head>
<body>
    <header class="site-header">
        <div class="header-main">
            <a class="brand" href="@Url.Action("Index", "Home")" aria-label="Trang chủ">
                <span class="brand-mark">T</span>
                <span class="brand-text"><strong>TRUYỆN HAY</strong></span>
            </a>

            @using (Html.BeginForm("Search", "Story", FormMethod.Get, new { @class = "search-box", role = "search" }))
            {
                <input type="search" name="q" placeholder="Bạn muốn tìm truyện gì?" />
                <button type="submit" aria-label="Tìm kiếm">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M16.5 16.5 21 21"></path></svg>
                </button>
            }

            <div class="auth-actions">
                @if (Session["IsAdmin"] is bool && (bool)Session["IsAdmin"])
                {
                    <a class="button button-register" href="@Url.Action("Index", "Admin")">Quản trị</a>
                }
                @if (Session["UserId"] != null)
                {
                    using (Html.BeginForm("Logout", "User", FormMethod.Post, new { @class = "header-logout-form" }))
                    {
                        @Html.AntiForgeryToken()
                        <button class="button button-login" type="submit">Đăng xuất</button>
                    }
                }
                else
                {
                    <a class="button button-register" href="@Url.Action("Register", "User")">Đăng ký</a>
                    <a class="button button-login" href="@Url.Action("Login", "User")">Đăng nhập</a>
                }
            </div>
        </div>

        <nav class="category-nav" aria-label="Danh mục truyện">
            <div class="category-inner">
                <a href="@Url.Action("Index", "Home")">Trang Chủ</a>

                <div class="nav-dropdown">
                    <a class="nav-dropdown-toggle" href="@Url.Action("Index", "Story")" aria-expanded="false" aria-controls="genre-menu">
                        Thể Loại <span class="dropdown-arrow">▼</span>
                    </a>
                    <div class="nav-dropdown-menu" id="genre-menu">
                        <a class="dropdown-all-link" href="@Url.Action("Index", "Story")">Tất cả thể loại</a>
                        @foreach (var genre in new[] { "Hành động", "Phiêu lưu", "Romance", "Hài hước", "Fantasy", "Manhwa", "Siêu nhiên", "Kinh dị", "Trinh thám", "Truyện chữ" })
                        {
                            <a href="@Url.Action("Index", "Story", new { category = genre })">@genre</a>
                        }
                    </div>
                </div>

                <div class="nav-dropdown">
                    <a class="nav-dropdown-toggle" href="@Url.Action("Index", "Story")" aria-expanded="false" aria-controls="rank-menu">
                        Xếp Hạng <span class="dropdown-arrow">▼</span>
                    </a>
                    <div class="nav-dropdown-menu" id="rank-menu">
                        @foreach (var ranking in new[] { "Top Ngày", "Top Tuần", "Top Tháng", "Top Năm", "Yêu thích" })
                        {
                            <a href="@Url.Action("Index", "Story", new { ranking = ranking })">@ranking</a>
                        }
                    </div>
                </div>

                @if (Session["UserId"] != null)
                {
                    <a href="@Url.Action("Index", "Story", new { follow = true })">Theo dõi</a>
                    <a href="@Url.Action("History", "Story")">Lịch sử</a>
                }
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <a class="footer-brand brand" href="@Url.Action("Index", "Home")" aria-label="Trang chủ">
            <span class="brand-mark">T</span>
            <span class="brand-text"><strong>TRUYỆN HAY</strong></span>
        </a>
    </footer>

    <button id="backToTop" class="back-to-top" type="button" aria-label="Lên đầu trang">▲</button>

    @Scripts.Render("~/bundles/jquery")
    <script>
        (function () {
            var dropdowns = document.querySelectorAll('.nav-dropdown');

            function closeDropdowns(except) {
                dropdowns.forEach(function (dropdown) {
                    if (dropdown !== except) {
                        dropdown.classList.remove('open');
                        var button = dropdown.querySelector('.nav-dropdown-toggle');
                        if (button) button.setAttribute('aria-expanded', 'false');
                    }
                });
            }

            dropdowns.forEach(function (dropdown) {
                var toggle = dropdown.querySelector('.nav-dropdown-toggle');

                dropdown.addEventListener('mouseenter', function () {
                    closeDropdowns(dropdown);
                    dropdown.classList.add('open');
                    toggle.setAttribute('aria-expanded', 'true');
                });

                dropdown.addEventListener('mouseleave', function () {
                    if (!dropdown.classList.contains('pinned')) {
                        dropdown.classList.remove('open');
                        toggle.setAttribute('aria-expanded', 'false');
                    }
                });

                toggle.addEventListener('click', function (event) {
                    event.stopPropagation();
                    var willOpen = !dropdown.classList.contains('open');
                    closeDropdowns(dropdown);
                    dropdown.classList.toggle('open', willOpen);
                    dropdown.classList.toggle('pinned', willOpen);
                    toggle.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
                });
            });

            document.addEventListener('click', function () {
                closeDropdowns(null);
                dropdowns.forEach(function (dropdown) {
                    dropdown.classList.remove('pinned');
                });
            });

            var backToTop = document.getElementById('backToTop');

            window.addEventListener('scroll', function () {
                if (window.pageYOffset > 300) {
                    backToTop.classList.add('show');
                } else {
                    backToTop.classList.remove('show');
                }
            });

            backToTop.addEventListener('click', function () {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        }());
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
