@model comic_website.Models.Story
@{
    ViewBag.Title = "Sửa thông tin truyện";
}
@section head {
    <style>
        .admin-form {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 24px;
            box-shadow: 0 4px 14px rgba(15, 23, 42, .05);
        }

        .admin-alert.error {
            padding: 12px 16px;
            border-radius: 8px;
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #991b1b;
            font-size: 14px;
            margin-bottom: 18px;
        }

        .admin-alert.error:empty,
        .validation-summary-valid { display: none; }

        .admin-edit-layout {
            display: grid;
            grid-template-columns: minmax(170px, 220px) minmax(0, 1fr);
            gap: 24px;
            align-items: start;
        }

        .admin-cover-preview {
            display: grid;
            min-height: 240px;
            place-items: center;
            overflow: hidden;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            background: #f9fafb;
        }

        .admin-cover-preview img {
            display: block;
            width: 100%;
            max-height: 320px;
            object-fit: cover;
        }

        .cover-placeholder { color: #6b7280; font-size: 14px; }

        .admin-form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
        }

        .admin-field {
            display: flex;
            flex-direction: column;
            gap: 7px;
            min-width: 0;
        }

        .admin-field.full { grid-column: 1 / -1; }

        .admin-field label {
            color: #374151;
            font-size: 13px;
            font-weight: 600;
        }

        .admin-field input:not([type="file"]),
        .admin-field select,
        .admin-field textarea {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            background: #fff;
            color: #111827;
            font: inherit;
            transition: border-color .15s ease, box-shadow .15s ease;
        }

        .admin-field input:focus,
        .admin-field select:focus,
        .admin-field textarea:focus {
            outline: none;
            border-color: #d97724;
            box-shadow: 0 0 0 3px rgba(217, 119, 36, .15);
        }

        .admin-field input[type="file"] {
            width: 100%;
            padding: 8px 0;
            color: #374151;
            font-size: 13px;
        }

        .admin-field input[type="file"]::file-selector-button {
            margin-right: 12px;
            padding: 9px 14px;
            border: 1px solid #fed7aa;
            border-radius: 7px;
            background: #fff7ed;
            color: #c86419;
            font: inherit;
            font-weight: 700;
            cursor: pointer;
            transition: background-color .18s ease, border-color .18s ease, color .18s ease, transform .18s ease;
        }

        .admin-field input[type="file"]::file-selector-button:hover {
            border-color: #fdba74;
            background: #ffedd5;
            color: #9a4c10;
            transform: translateY(-1px);
        }

        .admin-field input[type="file"]::-webkit-file-upload-button {
            margin-right: 12px;
            padding: 9px 14px;
            border: 1px solid #fed7aa;
            border-radius: 7px;
            background: #fff7ed;
            color: #c86419;
            font: inherit;
            font-weight: 700;
            cursor: pointer;
        }

        .admin-field textarea { min-height: 150px; resize: vertical; }

        .admin-form-actions {
            display: flex;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 22px;
            padding-top: 18px;
            border-top: 1px solid #e5e7eb;
        }

        @@media (max-width: 768px) {
            .admin-form { padding: 18px; }
            .admin-edit-layout { grid-template-columns: 1fr; gap: 18px; }
            .admin-cover-preview { width: min(100%, 220px); min-height: 180px; }
            .admin-form-grid { grid-template-columns: 1fr; gap: 15px; }
            .admin-field.full { grid-column: auto; }
        }
    </style>
}
<section class="admin-page">
    @Html.Partial("_AdminNav")
    <div class="admin-header">
        <div><p class="admin-eyebrow">Chỉnh sửa</p><h1>@Model.Title</h1></div>
        @Html.ActionLink("← Quay lại", "Stories", "Admin", null, new { @class = "admin-secondary-button" })
    </div>

    @using (Html.BeginForm("EditStory", "Admin", FormMethod.Post, new { @class = "admin-form", enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.StoryId)
        @Html.ValidationSummary(false, "", new { @class = "admin-alert error" })

        <div class="admin-edit-layout">
            <div class="admin-cover-preview">
                @if (!String.IsNullOrEmpty((string)ViewBag.CoverUrl))
                {
                    <img src="@ViewBag.CoverUrl" alt="Ảnh bìa @Model.Title" />
                }
                else
                {
                    <div class="cover-placeholder">Ảnh bìa</div>
                }
            </div>

            <div class="admin-form-grid">
                <div class="admin-field">
                    @Html.LabelFor(m => m.Title, "Tên truyện")
                    @Html.TextBoxFor(m => m.Title)
                </div>
                <div class="admin-field">
                    @Html.LabelFor(m => m.Author, "Tác giả")
                    @Html.TextBoxFor(m => m.Author)
                </div>
                <div class="admin-field">
                    <label for="categoryName">Thể loại</label>
                    @Html.DropDownList("categoryName", (SelectList)ViewBag.Categories, "-- Chọn thể loại --", new { id = "categoryName" })
                </div>
                <div class="admin-field">
                    <label for="coverFile">Ảnh bìa mới</label>
                    <input id="coverFile" type="file" name="coverFile" accept="image/jpeg,image/png,image/webp" />
                </div>
                <div class="admin-field full">
                    @Html.LabelFor(m => m.Description, "Mô tả")
                    @Html.TextAreaFor(m => m.Description, 7, 0, null)
                </div>
            </div>
        </div>

        <div class="admin-form-actions">
            @Html.ActionLink("Quản lý chương", "Chapters", "Admin", new { storyId = Model.StoryId }, new { @class = "admin-secondary-button" })
            <button class="admin-primary-button" type="submit">Cập nhật truyện</button>
        </div>
    }
</section>
