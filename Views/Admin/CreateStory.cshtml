@model comic_website.Models.Story
@{
    ViewBag.Title = "Thêm truyện mới";
}
@section head {
    <style>
        .admin-form {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 24px;
            box-shadow: 0 4px 14px rgba(15, 23, 42, .05);
        }

        .admin-alert.error {
            padding: 12px 16px;
            border-radius: 8px;
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #991b1b;
            font-size: 14px;
            margin-bottom: 18px;
        }

        .admin-alert.error:empty,
        .validation-summary-valid { display: none; }

        .admin-form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
        }

        .admin-field {
            display: flex;
            flex-direction: column;
            gap: 7px;
            min-width: 0;
        }

        .admin-field.full { grid-column: 1 / -1; }

        .admin-field label {
            color: #374151;
            font-size: 13px;
            font-weight: 600;
        }

        .admin-field input:not([type="file"]),
        .admin-field select,
        .admin-field textarea {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            background: #fff;
            color: #111827;
            font: inherit;
            transition: border-color .15s ease, box-shadow .15s ease;
        }

        .admin-field input:focus,
        .admin-field select:focus,
        .admin-field textarea:focus {
            outline: none;
            border-color: #d97724;
            box-shadow: 0 0 0 3px rgba(217, 119, 36, .15);
        }

        .admin-field input[type="file"] {
            width: 100%;
            padding: 8px 0;
            color: #374151;
            font-size: 13px;
        }

        .admin-field input[type="file"]::file-selector-button {
            margin-right: 12px;
            padding: 9px 14px;
            border: 1px solid #fed7aa;
            border-radius: 7px;
            background: #fff7ed;
            color: #c86419;
            font: inherit;
            font-weight: 700;
            cursor: pointer;
            transition: background-color .18s ease, border-color .18s ease, color .18s ease, transform .18s ease;
        }

        .admin-field input[type="file"]::file-selector-button:hover {
            border-color: #fdba74;
            background: #ffedd5;
            color: #9a4c10;
            transform: translateY(-1px);
        }

        .admin-field input[type="file"]::-webkit-file-upload-button {
            margin-right: 12px;
            padding: 9px 14px;
            border: 1px solid #fed7aa;
            border-radius: 7px;
            background: #fff7ed;
            color: #c86419;
            font: inherit;
            font-weight: 700;
            cursor: pointer;
        }

        .admin-field textarea { min-height: 150px; resize: vertical; }

        .admin-form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 22px;
            padding-top: 18px;
            border-top: 1px solid #e5e7eb;
        }

        @@media (max-width: 768px) {
            .admin-form { padding: 18px; }
            .admin-form-grid { grid-template-columns: 1fr; gap: 15px; }
            .admin-field.full { grid-column: auto; }
        }
    </style>
}
<section class="admin-page">
    @Html.Partial("_AdminNav")
    <div class="admin-header">
        <div><p class="admin-eyebrow">Nội dung</p><h1>Thêm truyện mới</h1></div>
        @Html.ActionLink("← Quay lại", "Stories", "Admin", null, new { @class = "admin-secondary-button" })
    </div>

    @using (Html.BeginForm("CreateStory", "Admin", FormMethod.Post, new { @class = "admin-form", enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(false, "", new { @class = "admin-alert error" })

        <div class="admin-form-grid">
            <div class="admin-field">
                <label for="Title">Tên truyện</label>
                <input id="Title" name="Title" type="text" value="@Model.Title" required />
            </div>
            <div class="admin-field">
                <label for="Author">Tác giả</label>
                <input id="Author" name="Author" type="text" value="@Model.Author" />
            </div>
            <div class="admin-field">
                <label for="categoryName">Thể loại</label>
                @Html.DropDownList("categoryName", (SelectList)ViewBag.Categories, "-- Chọn thể loại --", new { id = "categoryName" })
            </div>
            <div class="admin-field">
                <label for="coverFile">Ảnh bìa</label>
                <input id="coverFile" type="file" name="coverFile" accept="image/jpeg,image/png,image/webp" />
            </div>
            <div class="admin-field full">
                <label for="Description">Mô tả</label>
                <textarea id="Description" name="Description" rows="7">@Model.Description</textarea>
            </div>
        </div>

        <div class="admin-form-actions">
            <button class="admin-primary-button" type="submit">Lưu truyện</button>
        </div>
    }
</section>
