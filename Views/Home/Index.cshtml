@model IEnumerable<comic_website.Models.Story>
@{
    ViewBag.Title = "Truyện hot";
    var coverUrls = ViewBag.CoverUrls as System.Collections.Generic.IDictionary<int, string>
        ?? new System.Collections.Generic.Dictionary<int, string>();
}

<div class="home-sections">
    @foreach (var sectionTitle in new[] { "Top truyện", "Truyện hot", "Truyện mới ra", "Truyện được đọc nhiều nhất" })
    {
        <section class="comic-section">
            <div class="section-heading">
                <span class="heading-icon">★</span>
                <h1>@sectionTitle</h1>
            </div>

            <div class="comic-grid">
                @if (Model != null && Model.Any())
                {
                    foreach (var story in Model.Take(7))
                    {
                        <article class="comic-card">
                            <a href="@Url.Action("Details", "Story", new { id = story.StoryId })">
                                <div class="comic-cover">
                                    @if (coverUrls.ContainsKey(story.StoryId))
                                    {
                                        <img class="comic-cover-image" src="@Url.Content(coverUrls[story.StoryId])" alt="Ảnh bìa @story.Title" />
                                    }
                                    else
                                    {
                                        <span class="cover-letter">@(!String.IsNullOrWhiteSpace(story.Title) ? story.Title.Substring(0, 1) : "T")</span>
                                    }
                                    <span class="fresh-badge">Mới cập nhật</span>
                                </div>
                                <h2>@story.Title</h2>
                                <p>@(story.Chapters != null ? story.Chapters.Count : 0) chương</p>
                            </a>
                        </article>
                    }
                }
                else
                {
                    for (var i = 0; i < 7; i++)
                    {
                        <article class="comic-card">
                            <div class="comic-cover">
                                <span class="cover-letter">T</span>
                                <span class="fresh-badge">Mới cập nhật</span>
                            </div>
                            <h2>Tên truyện mẫu</h2>
                            <p>0 chương</p>
                        </article>
                    }
                }
            </div>

                    </section>
                }

                <div class="load-more-wrap">
                    <a class="load-more-button" href="@Url.Action("Index", "Story")">Xem tất cả truyện</a>
                </div>
            </div>
