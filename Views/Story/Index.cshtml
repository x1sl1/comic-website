@model IEnumerable<comic_website.Models.Story>
@{
    var isFollowOnly = ViewBag.FollowOnly is bool && (bool)ViewBag.FollowOnly;
    var updatedStoryIds = ViewBag.UpdatedStoryIds as int[] ?? new int[0];
    var coverUrls = ViewBag.CoverUrls as System.Collections.Generic.IDictionary<int, string>
        ?? new System.Collections.Generic.Dictionary<int, string>();
    ViewBag.Title = isFollowOnly ? "Truyện đang theo dõi" : "Tất cả truyện";
}
@section head {
    <style>
        .story-list-section .story-card-cover-image {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .story-list-section .fresh-badge.follow-update {
            right: 0;
            left: auto;
            border-radius: 3px 0 0 3px;
        }
    </style>
}

<section class="comic-section story-list-section">
    <div class="story-list-header">
        <div class="section-heading">
            <span class="heading-icon">★</span>
            <h1>@(isFollowOnly ? "Truyện đang theo dõi" : "Tất cả truyện")</h1>
        </div>

        @using (Html.BeginForm("Index", "Story", FormMethod.Get, new { @class = "story-filter", id = "storyFilter" }))
        {
            if (isFollowOnly)
            {
                @Html.Hidden("follow", "true")
            }
            <label for="categoryFilter">Thể loại</label>
            <select id="categoryFilter" name="category">
                <option value="">Tất cả thể loại</option>
                @if (ViewBag.Categories != null)
                {
                    foreach (var category in (IEnumerable<string>)ViewBag.Categories)
                    {
                        <option value="@category">@category</option>
                    }
                }
            </select>

            <label for="rankingFilter">Xếp hạng</label>
            <select id="rankingFilter" name="ranking">
                <option value="">Tất cả xếp hạng</option>
                @foreach (var ranking in new[] { "Top Ngày", "Top Tuần", "Top Tháng", "Top Năm", "Yêu thích" })
                {
                    <option value="@ranking">@ranking</option>
                }
            </select>

            <label for="nameSortFilter">Tên truyện</label>
            <select id="nameSortFilter" name="nameSort">
                <option value="">Không sắp xếp</option>
                <option value="A-Z">A-Z</option>
                <option value="Z-A">Z-A</option>
            </select>

            <button type="submit">Lọc truyện</button>
        }
    </div>

    <div class="comic-grid">
        @if (Model != null && Model.Any())
        {
            foreach (var story in Model)
            {
                <article class="comic-card">
                    <a href="@Url.Action("Details", "Story", new { id = story.StoryId })">
                        <div class="comic-cover">
                            @if (coverUrls.ContainsKey(story.StoryId))
                            {
                                <img class="story-card-cover-image" src="@Url.Content(coverUrls[story.StoryId])" alt="Ảnh bìa @story.Title" />
                            }
                            else
                            {
                                <span class="cover-letter">@(!String.IsNullOrWhiteSpace(story.Title) ? story.Title.Substring(0, 1) : "T")</span>
                            }
                            @if (isFollowOnly && updatedStoryIds.Contains(story.StoryId))
                            {
                                <span class="fresh-badge follow-update">Mới cập nhật</span>
                            }
                        </div>
                        <h2>@story.Title</h2>
                        <p>@(story.Chapters != null ? story.Chapters.Count : 0) chương</p>
                    </a>
                </article>
            }
        }
        else
        {
            <p class="empty-story-list">@(isFollowOnly ? "Bạn chưa theo dõi truyện nào phù hợp." : "Không tìm thấy truyện phù hợp.")</p>
        }
    </div>
</section>

@section scripts {
    <script>
        (function () {
            var category = '@(ViewBag.SelectedCategory ?? "")';
            var ranking = '@(ViewBag.SelectedRanking ?? "")';
            var categoryFilter = document.getElementById('categoryFilter');
            var rankingFilter = document.getElementById('rankingFilter');
            var nameSortFilter = document.getElementById('nameSortFilter');
            var nameSort = '@(ViewBag.SelectedNameSort ?? "")';

            if (categoryFilter) {
                categoryFilter.querySelectorAll('option').forEach(function (option) { option.selected = option.value === category; });
            }
            if (rankingFilter) {
                rankingFilter.querySelectorAll('option').forEach(function (option) { option.selected = option.value === ranking; });
            }
            if (nameSortFilter) {
                nameSortFilter.querySelectorAll('option').forEach(function (option) { option.selected = option.value === nameSort; });
            }

            var filterForm = document.getElementById('storyFilter');
            if (filterForm) {
                var submitButtons = filterForm.getElementsByTagName('button');
                filterForm.querySelectorAll('select').forEach(function (select) {
                    select.addEventListener('change', function () {
                        if (submitButtons.length > 0) submitButtons[0].click();
                    });
                });
            }
        }());
    </script>
}
