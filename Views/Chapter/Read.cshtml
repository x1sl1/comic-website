@model comic_website.Models.Chapter
@{
    var pageTitle = String.IsNullOrWhiteSpace(Model.Title) ? "Chương " + Model.ChapterNumber : Model.Title;
    var chapterImages = comic_website.Models.ChapterImageContent.GetImageUrls(Model.Content);
    var isImageCollection = comic_website.Models.ChapterImageContent.IsImageCollection(Model.Content);
    int? previousChapterId = ViewBag.PreviousChapterId is int ? (int)ViewBag.PreviousChapterId : (int?)null;
    int? nextChapterId = ViewBag.NextChapterId is int ? (int)ViewBag.NextChapterId : (int?)null;
    ViewBag.Title = pageTitle;
}
@section head {
    <style>
        .chapter-reader {
            width: 100%;
            margin: 0 auto 32px;
            padding: 0;
            background: #121212;
        }

        .chapter-reader-header {
            max-width: 820px;
            margin: 0 auto;
            padding: 22px 16px;
            border-bottom: 1px solid #e5e7eb;
            background: #fff;
        }

        .chapter-reader-header p {
            margin: 0 0 6px;
            color: #d97724;
            font-size: 13px;
            font-weight: 700;
        }

        .chapter-reader-header h1 {
            margin: 0;
            color: #111827;
            font-size: 24px;
        }

        .reader-navigation {
            display: flex;
            max-width: 820px;
            justify-content: space-between;
            gap: 12px;
            margin: 0 auto;
            padding: 12px 16px;
            background: #fff;
        }

        .reader-navigation a {
            color: #c86419;
            font-weight: 700;
        }

        .reader-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 100%;
            margin: 0 auto;
            padding: 0;
            background: #121212;
        }

        .reader-strip {
            display: block;
            width: 100%;
            max-width: 820px;
            height: auto;
            margin: 0;
            padding: 0;
            border: 0;
        }

        .chapter-reader-text {
            max-width: 820px;
            margin: 0 auto;
            padding: 24px;
            background: #fff;
            white-space: pre-wrap;
            line-height: 1.8;
        }

        @@media (max-width: 600px) {
            .reader-strip { max-width: 100%; }
            .chapter-reader-header h1 { font-size: 20px; }
            .reader-navigation { padding: 12px; font-size: 14px; }
        }
    </style>
}
<section class="chapter-reader">
    <header class="chapter-reader-header">
        <p>Chương @Model.ChapterNumber</p>
        <h1>@pageTitle</h1>
    </header>

    @if (chapterImages.Count > 0)
    {
        <nav class="reader-navigation" aria-label="Điều hướng chương">
            @if (previousChapterId.HasValue)
            {
                <a href="@Url.Action("Read", "Chapter", new { id = previousChapterId.Value })">← Chương trước</a>
            }
            else
            {
                <span></span>
            }
            <a href="@Url.Action("Details", "Story", new { id = Model.StoryId })">Danh sách chương</a>
            @if (nextChapterId.HasValue)
            {
                <a href="@Url.Action("Read", "Chapter", new { id = nextChapterId.Value })">Chương sau →</a>
            }
            else
            {
                <span></span>
            }
        </nav>
        <div class="reader-container">
            @for (var index = 0; index < chapterImages.Count; index++)
            {
                <img class="reader-strip"
                     src="@Url.Content(chapterImages[index])"
                     alt="Dải tranh @(index + 1) - @pageTitle"
                     loading="@(index < 2 ? "eager" : "lazy")"
                     decoding="async" />
            }
        </div>
        <nav class="reader-navigation" aria-label="Điều hướng chương cuối trang">
            @if (previousChapterId.HasValue)
            {
                <a href="@Url.Action("Read", "Chapter", new { id = previousChapterId.Value })">← Chương trước</a>
            }
            else
            {
                <span></span>
            }
            <a href="@Url.Action("Details", "Story", new { id = Model.StoryId })">Danh sách chương</a>
            @if (nextChapterId.HasValue)
            {
                <a href="@Url.Action("Read", "Chapter", new { id = nextChapterId.Value })">Chương sau →</a>
            }
            else
            {
                <span></span>
            }
        </nav>
    }
    else if (!String.IsNullOrWhiteSpace(Model.Content) && !isImageCollection)
    {
        <div class="chapter-reader-text">@Model.Content</div>
    }
    else
    {
        <p>Chương này chưa có nội dung.</p>
    }
</section>
